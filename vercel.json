{
  "cleanUrls": true,
  "redirects": [
    { "source": "/refinance", "destination": "/refinance-guide", "permanent": true },
    { "source": "/refinance/", "destination": "/refinance-guide/", "permanent": true },
    { "source": "/how-much-house-can-i-afford", "destination": "/affordability-guide", "permanent": true },
    { "source": "/how-much-house-can-i-afford/", "destination": "/affordability-guide/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
